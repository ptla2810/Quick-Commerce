# ── Copy to .env for local development. Never commit real secrets. ──
NODE_ENV=development
PORT=4000

# Local embedded PostgreSQL started by `npm run db:start` (port 5433 avoids clashing with a system Postgres).
DATABASE_URL=postgresql://padosi:padosi_dev_password@localhost:5433/padosi?schema=public
# Separate database used by the automated test suite (it is wiped on every test run).
TEST_DATABASE_URL=postgresql://padosi:padosi_dev_password@localhost:5433/padosi_test?schema=public

# Comma-separated list of browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_DAYS=30
# Set to true when serving over HTTPS so cookies are marked Secure.
COOKIE_SECURE=false

# Development-only demo account sign-in. Refused at startup when NODE_ENV=production.
ENABLE_DEMO_LOGIN=true
# Password given to seeded demo users (development only). Change it if you share the machine.
DEMO_USER_PASSWORD=Demo@2026

# Provider selection: mock providers need no credentials and are refused in production.
PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
PUSH_PROVIDER=mock
MAPS_PROVIDER=local
STORAGE_PROVIDER=local
STORAGE_DIR=./storage

# Razorpay (only when PAYMENT_PROVIDER=razorpay; requires merchant onboarding)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS gateway (only when SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Public base URL of the web app (used in links inside notifications)
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=info
