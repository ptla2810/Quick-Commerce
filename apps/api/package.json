{
  "name": "@padosi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "prisma generate && tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "db:start": "node scripts/dev-db.mjs",
    "db:setup": "prisma migrate deploy && tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "prisma": "prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@padosi/shared": "0.1.0",
    "@prisma/client": "6.19.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "multer": "2.4.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.0",
    "@types/supertest": "6.0.3",
    "embedded-postgres": "17.10.0-beta.17",
    "pino-pretty": "13.1.1",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "tsup": "8.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
